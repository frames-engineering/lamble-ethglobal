    "cn": "^0.4.0",
    "lightweight-charts": "^5.2.1",
    "liveline": "^0.0.7",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "mppx": "^0.13.5",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
