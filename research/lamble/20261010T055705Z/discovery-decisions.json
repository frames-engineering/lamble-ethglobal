  "decisions": {
    "k-post": {
      "decision": "created",
      "narrativeId": "n-post-quantum",
      "reason": "Post-quantum coins qualify: QI, PQC, Tardigrade, Quantcum and BNKR name post-quantum cryptographic proofs on pqc.market in their metadata and BUNKER (Bunker Mode) names hash-based authorization: six coins and about $19.4M of rolling 24h volume against the $500K bar, all on pump.fun. Independent sources: Justin Drake's 2026-10-07 \"bunker mode\" post, Vitalik Buterin's post and The Block's report on Europol (e4:0, e4:1), plus the pqc.market page (e4:2). It resolves the k-quantum lead deferred yesterday (two coins, project-only source). SNOOP (\"Tag me under any post\") matched on the word post only. Quantum-themed coins that are not post-quantum cryptography are not added: qOMPUTE and QUBIT (quarantined, extreme 24h moves), the second QI contract (quarantined, implausible market cap), two Quantum Cat coins, QOAT and qpepe (quantum-random meme coins). At the cap it replaces n-inference-credits, the smallest narrative."
    },
    "k-super": {
      "decision": "rejected",
      "reason": "Super Intelligent Beauty (SIB): three contracts named SIB or similar (two SIB, about $3.67M and $0.99M, plus PERSUASION with empty metadata). Posts on 2026-10-10 say Elon Musk replied \"Super Intelligent Beauty\" to an AI video from @tetsuoai; that is a one-day meme, not the White House \"Super Intelligence\" rename behind n-super-intelligence, and only one of the SIB contracts has metadata (\"Fees to @tetsuoai via UsePaid\"). Fewer than three coins name one story; revisit if the Musk reply keeps spawning coins with metadata."
    },
    "k-powered": {
      "decision": "rejected",
      "reason": "Generic phrase. PQC joins the post-quantum narrative on its own metadata; TasQ (private compute on Robinhood Chain, \"Your SI (AI)\") stays deferred; NOTHUMAN is a Susan Dell reptilian-meme coin."
    },
    "k-fees": {
      "decision": "rejected",
      "reason": "Different mechanisms behind the word fees: CALI (fees to Maye Musk via X money, already rejected), API (fees split by holdings and AI credits), SIB (fees to @tetsuoai), HARMONIC (an agent that claims its own creator fees) and WIRED (fees wired to social accounts). No shared story or independent source."
    },
    "k-wallet": {
      "decision": "deferred",
      "reason": "New lead: Robinhood Chain agents with their own wallets. DAEMON (an NFT with its own wallet and agentfile, about $0.94M), Dots (a Dot with its own wallet that trades tokens 24/7, about $0.63M), TRENCHERS (NFT-identified trading agents, about $0.11M) and HARMONIC (an autonomous agent that claims its own creator fees, about $0.21M) total about $1.9M of 24h volume on pons, but the only sources found are the projects' own posts (e3:4: @Daemon_rhc and promotional calls) and MESH (a compute network) does not fit. Re-check for an independent source."
    },
    "k-robinhood": {
      "decision": "rejected",
      "reason": "The word Robinhood Chain over unrelated products: DAEMON and Dots go to the deferred k-wallet lead, PAPA is a news platform with stock rewards and no tokenized-asset mechanism."
    },
    "k-agent": {
      "decision": "rejected",
      "reason": "Generic word. ALOIS (an Alzheimer's research agent, pump.fun) has no shared story with HARMONIC or TRENCHERS; those two sit in the deferred k-wallet lead."
    }
  }
