  "decisions": {
    "k-sym-KIMCHI": {
      "decision": "assigned",
      "narrativeId": "n-kimchi-pumpfun",
      "reason": "The three coins share the symbol Kimchi, the name of the trader the Kimchi narrative tracks (still posted about today, e1:2, e2:0). Two of them are new members: the Clanker copy on Base (Aura Final Boss, 0xbb409a..., 3 hours old, about $49.9M rolling 24h volume) and project kimchi on pump.fun (B1Y2fJ..., 10 hours old, about $9.0M). The third, the pump.fun contract the posts name (Aura Final Boss, CSocnz..., 55 hours old, about $11.2M, -55% on 24h), carried no quarantine flag again but is recorded as quarantined by an earlier run, so it is not counted and stays a deferred candidate for the owner. Today's posts say Kimchi removed Pump.fun from his bio and the coin fell about 50% (e1:2, @lookonchain and @Velvet_Capital, unverified here)."
    },
    "k-take": {
      "decision": "rejected",
      "reason": "Nagi and Pokke (ヤギ, a Japan Rail goats story), NOWHEEL (a Cybercab meme) and FloatSheets share only the word take. The goats story is popular but has no source beyond trader promotions (e2:1 returned only call-style posts), and the coin pairs on two launchpads are one story of two coins. FloatSheets joins the perpetual-futures narrative on its description, not on this word."
    },
    "k-fees": {
      "decision": "rejected",
      "reason": "Pepper The Raccoon (fees to its owner for an animal sanctuary, e2:2), TURRI (fees to an AI program), XMR Roots and Orbio.so share only the word fees; four different fee designs and no common story or source. Pepper is a one-coin animal-news story the previous run had already removed."
    },
    "k-behind": {
      "decision": "rejected",
      "reason": "Pootcoin (a compute wordplay, e2:3), Exfil.fun and v4 Marketplace share only the word behind; three products, no common story ($2.2M combined)."
    },
    "k-agent": {
      "decision": "rejected",
      "reason": "scribes (inscribe your agent on Solana), Shiitake (an agent harness), Ostra Agent, Agent ID and Onagi (a trading app with an agent) are five different products; e2:4 returned trader call promotions only. Agent is a tag, not a story."
    },
    "k-same": {
      "decision": "rejected",
      "reason": "NOWHEEL, zonki and TURRI share only the word same; e2:5 and e2:6 returned call-group promotions and scam warnings."
    },
    "k-open": {
      "decision": "rejected",
      "reason": "zonki, XTO (an oil-investing coin, see the oil-fund lead in candidates) and Shiitake share only the word open."
    },
    "k-traders": {
      "decision": "assigned",
      "narrativeId": "n-perpetual-futures",
      "reason": "Virtual Trade (VIRTUAL) and FloatSheets (FLOAT) joined n-perpetual-futures on their own descriptions (a perpetual trading protocol with up to 1000x; a synthetic equity perps platform, e2:7, e2:8), not on the word traders. Frens (a social copy-trading app) is a different product and stays a rejected candidate."
    },
    "k-built": {
      "decision": "rejected",
      "reason": "Virtual Trade, Creora (private AI), Givest (RWA stock sending) and ProvisoFinance share only the word built. Virtual Trade joins the perpetual-futures narrative on its description."
    },
    "k-earn": {
      "decision": "rejected",
      "reason": "Virtual Trade, Orbio.so (OpenRouter credits) and SIDELOT (an OTC exchange) share only the word earn; three products, no common story."
    },
    "k-robinhood": {
      "decision": "rejected",
      "reason": "FloatSheets, Macca the Gator, HOOKLINE, Ostra Agent, Givest, Onagi and ProvisoFinance share only the chain name (Robinhood Chain); seven products. FloatSheets joins the perpetual-futures narrative on its description; MACCA is a GTA 6 mascot and not the Dacity Coin."
    },
    "k-pool": {
      "decision": "rejected",
      "reason": "ShadowPrivacy (private payments on Solana; e2:9 returned a scam warning and promotions), HOOKLINE (a swap router) and Ostra Agent share only the word pool."
    }
  }
