  "decisions": {
    "k-intelligence": {
      "decision": "assigned",
      "narrativeId": "n-super-intelligence",
      "reason": "Two of the three Tetsuo Super Intelligence (TSI) coins joined n-super-intelligence: Clanker on Robinhood Chain ($8.3M, market cap $2.0M) and pump.fun AcV6Cc... ($4.4M, market cap $270K). Their names carry the story's term and trader posts call TSI \"another SI coin\" (e2:0), but no source links them to the announcements and both pools were hours old, so the copy says so. The third TSI (pump.fun 3ZvEee..., $0.86M) has a $66K market cap, under the $100K bar. WEFT (\"Financial intelligence for everyone\") shares only the word. As a separate narrative it would only duplicate Super Intelligence."
    },
    "k-internet": {
      "decision": "rejected",
      "reason": "CATSZN (cat meme, hours old), iMolest (Steve Jobs/Epstein joke) and Dickbuttifier share only the word \"internet\" in their descriptions; the CATSZN X results (e2:1) are call-group promotion with no news or official source."
    },
    "k-sym-MASSIVE": {
      "decision": "deferred",
      "reason": "Three MASSIVE contracts (Meteora DBC x2 and pump.fun, $3.1M combined, pools 0 to 0.5 hours old) tie to massive.gg, whose own account posted that $MASSIVE launches live on 2026-10-17 (e3:0). Only the pump.fun contract's metadata (\"massive.gg\") names it; the two Meteora DBC contracts have empty metadata, and the pools are too new to tell which contract is the real one. Fails the metadata bar today; re-evaluate tomorrow once the pools have a day of history."
    },
    "k-fees": {
      "decision": "rejected",
      "reason": "SUPERCORE (fees help fund films and music videos), YORE (50% of its launchpad's fees buy back and burn it, creator fees go to the Injective community) and ORBIO (fees converted to inference credits for holders, a closed mechanism from a retired narrative) are not creator fees routed to a named person; the SUPERCORE X results (e3:1) are call-group promotion."
    },
    "k-robinhood": {
      "decision": "rejected",
      "reason": "INFLUENCE (a SocialFi key economy), IGNITION (a launchpad) and SPATIAL (peer-to-peer lending against stock tokens) share only the chain name. The @Influencefamily posts (e3:2) describe a SocialFi product, not AI influencer characters."
    }
