  "decisions": {
    "k-fees": {
      "decision": "created",
      "narrativeId": "n-launchpad-coins",
      "reason": "LAUNCH (a coin that says it launches coins on StonkFun), LAUNCHCAT and bInference share only the word fees/launch. LAUNCH, with RAYPAD, NTRNDM and HOOKED, meets the bar as a launchpad theme: four coins on covered launchpads whose metadata names a launchpad or launch tool, $7.93M combined rolling volume, a GeckoTerminal post (e2:1) and notrandom.fun's official page (e3:0). LAUNCHCAT is a cat meme (\"launch cat launched on launch\") and bInference sells AI credits: not members."
    },
    "k-runs": {
      "decision": "created",
      "narrativeId": "n-launchpad-coins",
      "reason": "The word runs links LAUNCH and HOOKED (both now members of the new Launchpad and launch-tool coins narrative) with Zenity (an AI-agent security firm) and Thinkr (private AI), which are unrelated and not added."
    },
    "k-built": {
      "decision": "rejected",
      "reason": "Claude (a Clanker coin on Robinhood Chain), Hooked and Zenity share only the word built. Claude's description is a generic blurb about the Anthropic assistant; Zenity is an AI-agent security firm. No common story; Hooked joins the launchpad narrative on its own metadata."
    },
    "k-mascot": {
      "decision": "rejected",
      "reason": "GTA Dog Mascot (Chop), Palu (a Binance mascot) and Fat Panda (the mascot of BNCB) share only the word mascot. The Chop posts (e2:2) are call-group promotions and a scam alert; one post (2026-10-21) ties the Chop character to GTA VI but names no coin. Not a shared story."
    },
    "k-titty": {
      "decision": "rejected",
      "reason": "Giga Titty Ass (GTA), Big Natural Boobs and Extra Thick Hoe share crude name jokes. Posts (e2:3) call GTA a gooner-meta meme and one flags it as bundled; nothing links them to a news or official source, and the GTA 6 mention is a pun on the ticker."
    },
    "k-paired": {
      "decision": "deferred",
      "reason": "Big Testicle Coin (BTC), Big Natural Boobs (BNB) and Extra Thick Hoe (ETH) on pump.fun say they are paired with BTC/wBTC and reward holders; one verified account (@mjdwarner, 2026-10-25, e2:4) says BTC is paired with WBTC through the notrandom.fun setup. Only two of the three meet the member bars (BTC has a $83K market cap, under the $100K bar; the parent Big Titty Coin has empty metadata), so the cluster is below three qualifying coins. Re-check tomorrow."
    },
    "k-agent": {
      "decision": "rejected",
      "reason": "FLAPAI (\"Agent-only launchpad on BNB Chain\", $65K market cap, under the $100K bar), Zenity and bInference share only the word agent. Flap's own post of 2026-10-23 (e2:5) announces FLAP APPS with an agent-token app, but only one coin is tied to it and it fails the market-cap bar; recorded as a candidate."
    },
    "k-anyone": {
      "decision": "rejected",
      "reason": "Big Natural Boobs, Extra Thick Hoe and Thinkr share only the word anyone (generic); no common story."
