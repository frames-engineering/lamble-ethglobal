  "decisions": {
    "k-kimchi": {
      "decision": "created",
      "narrativeId": "n-kimchi-pumpfun",
      "reason": "Created n-kimchi-pumpfun. Four coins whose own metadata names Kimchi (two Kimchi symbols with \"Aura Final Boss\" and \"official kimchi coin\", Kimchi Boss, and a coin named kimchi) have pools created between 23:08 UTC on 2026-10-20 and 00:45 UTC on 2026-10-21, about $17.5M of rolling 24h volume in total, and the older Aura Final Boss (description naming @kimchi1x, pool from 2026-07-27) joins as a fifth. Independent sources: @kimchi1x's own reply to @Pumpfun (e3:0), a Pump.fun Ecosystem post (e3:0) and the kimchlsol distribution post (e2:1), dated 2026-10-20 to 2026-10-21. The coin the posts name (CSocnz...) and two more Kimchi contracts are quarantined (extreme 24h move, pools 6 to 7 hours old) and are not counted. Borderline: the name Kimchi is the story's own name rather than a shared theme word, but none of the five is tied to Kimchi by a source."
    },
    "k-boss": {
      "decision": "assigned",
      "narrativeId": "n-kimchi-pumpfun",
      "reason": "The Aura Final Boss coins in this cluster are the Kimchi coins assigned to n-kimchi-pumpfun (Kimchi on Clanker V4 and on pump.fun, and Kimchi Boss). BREZ (Course Final Boss) shares only the word Boss and is rejected."
    },
    "k-final": {
      "decision": "assigned",
      "narrativeId": "n-kimchi-pumpfun",
      "reason": "Two of the four coins are the Aura Final Boss Kimchi coins assigned to n-kimchi-pumpfun. HEYI (The Final Form COW, Flap, empty metadata) and BREZ (Course Final Boss, pump.fun, empty metadata) share only the word Final and are rejected."
    },
    "k-onchain": {
      "decision": "assigned",
      "narrativeId": "n-perpetual-futures",
      "reason": "Only Papertrade (Paper, Clanker V4, Base) belongs to a story: its metadata describes the fully onchain perpetual exchange and it joins n-perpetual-futures. GH0ST (a gas-efficient on-chain AI project) and TimQ (an AI quant for onchain traders) share only the word onchain and are rejected."
    },
    "k-sym-PHP": {
      "decision": "deferred",
      "reason": "Four coins named PHP-UP-2026 (pump.fun x1 with the description \"They dropped an exploit that allows you to drain money from anyone\", MeteoraDBC x3 with empty descriptions; pools 12 to 42 minutes old, about $5.0M of rolling 24h volume, market caps $155K to $460K, no quarantine flag) meet the volume bar and the story bar: the name is the title of the leaked PHP exploit write-up (jackalsyn.com/posts/php-up-2026.html), and php.net's announcement of an emergency security release for two critical vulnerabilities (CVE-2026-109618 and CVE-2026-109619) at 14:00 UTC on 2026-10-21, a Cloudflare emergency WAF release and security researchers' posts confirm it (e3:2). The narrative cap is full (six active after Flying Tesla Roadster is resumed by the owner's decision), the weakest candidate to replace is that resumed narrative, and the pools are under an hour old, so this is deferred, not rejected. Re-check next run (the PHP search stays in dailyEvidence); a borderline call the owner may want to make."
    },
    "k-money": {
      "decision": "rejected",
      "reason": "Money Business (MONEYBIZ, a capuchin meme), PHP-UP-2026, Grand Theft Arcade and Cashed Money share only the word money. PHP-UP-2026 is its own deferred lead; Cashed Money was removed earlier; a trader post calls MONEYBIZ a bundled scam (e2:3)."
    },
    "k-agent": {
      "decision": "rejected",
      "reason": "Agent ID (.ai, Flap, empty metadata), Alchemist AI (an old project, 16,620 hours) and Factor (agent financing on Robinhood Chain) share only the word agent; no common story and no source (e2:4)."
    },
    "k-earn": {
      "decision": "rejected",
      "reason": "QUANTS (an NFT-backed launchpad), Orbio.so (removed earlier) and Raeto (removed earlier) share only the word earn. The AI-compute-credits lead (ORBIO, RAETO, BORLY) was settled in earlier runs; the Borly search stays in dailyEvidence. Posts about QUANTS (e2:5) describe NFT minting and staking rewards, a different story."
    },
    "k-fees": {
      "decision": "rejected",
      "reason": "Orbio.so, GH0ST, Mimi (fees to charity), Cashed Money and Factor share only the word fees; the fee-sharing designs are different and nothing ties them to one story (e2:6)."
    },
    "k-paired": {
      "decision": "rejected",
      "reason": "589 is paired with XRP, a crypto coin, not a tokenized stock, so it does not belong to n-stock-paired-coins; Flying Tesla Roadster is already in its own narrative. Nvidia Paired Cat (NPC, pump.fun, empty description, $502K of volume, $863K market cap) has a name that suggests the stock pairing but nothing else: recorded as a deferred candidate, not added (it was not in this run's collection plan)."
    },
    "k-future": {
      "decision": "rejected",
      "reason": "BFC (a Binance-themed Flap coin), POFD (a Chinese-language mining token) and NAFF (a fund-themed token, deferred earlier) share only the word future; no common story (e2:8 returned unrelated posts)."
    },
    "k-binance": {
      "decision": "rejected",
      "reason": "BFC, Binance AI (BIBI) and Binance Pay are three Binance-themed coins on Flap with different pitches (BIBI says it is a relaunch of an older BIBI); no independent source for a shared story was found, and posts say nothing about them."
    },
    "k-agents": {
      "decision": "rejected",
      "reason": "Alchemist AI, TimQ and Factor share only the word agents; no common story and no source (e2:9)."
    }
  }
}
