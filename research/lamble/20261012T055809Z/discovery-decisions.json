  "decisions": {
    "k-earn": {
      "decision": "rejected",
      "reason": "The word earn over unrelated products: apelink (\"turns Solana token calls into X-attributed buy links. Callers earn 1% of trades made through their links\", $1.34M; posts describe shill-to-earn referral links, e2:0) is a single referral tool with no sibling coins; CLAWHUNTER (agents earning bounties) is a single agent-tools coin; ORBIO goes to the AI credits narrative (k-credits); OTC stays with the deferred stock-yield lead (STONK, OTC; project-only sources). No shared story."
    },
    "k-stocks": {
      "decision": "assigned",
      "narrativeId": "n-tokenized-assets",
      "reason": "HUME MARKETS (\"Tokenized stocks, all in one place. Perps. Options. Lending & Borrowing\", $210K, pons) is added to n-tokenized-assets, together with Ballast (BLLS, \"Stock Token portfolios on @Robinhoodapp\", $308K), which the word match missed. STONK (\"Backed by stocks\", $1.87M) and OTC (\"earn stocks, pre-ipo, and yield\", $733K) stay deferred: their only sources are the projects' own promotions (e2:1 is trader and promoter posts about STONK's rewards) and neither describes tokenized stocks. Kairo (a trading agent) and GRASS (a game of stocks hidden in the real world) are not tokenized-asset products."
    },
    "k-goes": {
      "decision": "rejected",
      "reason": "Generic word over unrelated coins: FARM (the token of the farmfun.farm launchpad; the posts found are the project's own and a fake-token warning, e2:2), FIGHT (a memecoin battle app), Pororo (a Korean cartoon penguin) and TRIAN (a pixel-art island memecoin)."
    },
    "k-through": {
      "decision": "rejected",
      "reason": "Generic word over apelink (referral buy-links), CLAWHUNTER (agent bounties) and LLM (LLMPad), which goes to the AI credits narrative through k-credits. No shared story beyond the word."
    },
    "k-credits": {
      "decision": "created",
      "narrativeId": "n-credits-for-holders",
      "reason": "Created n-credits-for-holders (AI credits for holders), re-evaluating yesterday's deferred lead with the follow-up the rule asks for. API ($1.07M), ORBIO ($862K), LLM ($272K) and BINF ($89K) total about $2.29M in 24h token volume, with four coins on Pump.fun, pons and Flap whose metadata names AI credits for holders, against $1.32M for the smallest existing narrative. Sources beyond metadata: Orbio's own page, scraped today, describes the credit discount market and holders supplying credit (e3:1); a rival project, DecentraMind, says ORBIO pioneered the model it builds on (e3:2); two traders compare BINF and API with ORBIO (e3:3, e2:3); and a new AI-credits launchpad announced the same idea (e3:2). That meets the bar as written (official page or X posts beyond metadata); every payout, discount and usage figure remains the projects' own claim, and yesterday's concern that the sources are mostly project accounts still applies, so it is flagged for the owner. At the six-narrative cap it replaces the smallest narrative, Agency."
    },
    "k-robinhood": {
      "decision": "rejected",
      "reason": "A venue word over unrelated products: MOTION (a 0%-fee trading terminal), Dots (agents with wallets, still only project posts and part of the deferred wallets lead), GRASS (a game) and HUME. HUME is assigned to the tokenized assets narrative through k-stocks."
    }
  }
