  "decisions": {
    "k-pumpfun": {
      "decision": "rejected",
      "reason": "The word pumpfun over unrelated products: TM (TeleMoney, \"Launch coins on pumpfun with fees redirected to any telegram username\", about $4.4M) is a fee-routing tool and goes to the deferred fee-routing lead below; API (credits for holders) goes to the deferred credits lead (k-credits); NTRNDM is a generic coin. No shared story."
    },
    "k-super": {
      "decision": "assigned",
      "narrativeId": "n-super-intelligence",
      "reason": "Ollie (\"My Super Intelligence Cat\", about $1.68M) and SPACEXSI (\"SpaceX Super Intelligence OG\", about $1.33M) name the Super Intelligence rename and SpaceXSI story behind n-super-intelligence (White House SIF post and the SpaceXSI rename, 2026-10-04, e1:6) and are added to it. SUPMKT (Super Market Inu, about $2.06M) is not: its metadata says it is a shopping-cart shiba, \"Not official. Not linked to any other coin\"; the word super is a coincidence. Its X results are paid-alpha promotions and one scam warning (e2:1)."
    },
    "k-credits": {
      "decision": "deferred",
      "reason": "Strongest lead of the day, not created. API (\"Fees split by holdings every 10 min. Claim SOL or 1.5x credits for GPT, Claude, Grok & Gemini\", $1.31M), LLM (LLMPad, \"generate LLM credits\", $1.30M), ORBIO (\"earn OpenRouter credits\", $1.10M; closed member of the retired n-inference-credits) and BINF ($0.11M) total about $3.8M, but the only sources are the projects' own accounts and a trader post calling API \"basically ORBIO, but better\" (e2:2); a targeted follow-up search for independent coverage found none (e3:2). With a source this thin the call is for the owner: it would displace Agency (about $1.1M, the smallest narrative) if created. Re-check for news or an official source tomorrow."
    },
    "k-market": {
      "decision": "rejected",
      "reason": "Generic word. SUPMKT is a meme shiba, LLM is the credits lead, SKYC (a US stock community bridging to BNB Chain via Butterfly, about $191K) describes no tokenized-stock mechanism, FLW is a Robinhood Chain routing product. No shared story."
    },
    "k-other": {
      "decision": "rejected",
      "reason": "Generic word over SUPMKT (meme shiba), ACT (Act I: The AI Prophecy, a 17,000-hour-old token) and VOLUMIZER (a volume-bot launchpad coin). No shared story."
    },
    "k-build": {
      "decision": "rejected",
      "reason": "Generic word. FACTORY (Baton Factory) is a game token that its studio lists in the Imagine Game Labs catalogue (e2:3); the others are unrelated (Binance Man, SKYC). No shared story."
    },
    "k-quantum": {
      "decision": "assigned",
      "narrativeId": "n-post-quantum",
      "reason": "QHOST (Qhost, Robinhood Chain; metadata \"The first quantum-resistant launchpad ... keys it can't break\", about $354K) names the post-quantum story and is added to n-post-quantum. Not added: QT (Quantum Tiger, \"One quantum leap into the unknown\": a quantum-themed meme), QCAT (Quantum Cat, a Meteora liquidity-routing coin), QSHIELD (Quantum Shield: empty metadata, so no coin evidence; deferred) and the quarantined qOMPUTE, QUBIT and second QI contract. Posts show many new Solana coins using the word quantum (QWOLF, qLAb, Quantum Trump); none has post-quantum cryptography in its metadata."
    },
    "k-agents": {
      "decision": "rejected",
      "reason": "Generic word over LLM (credits lead), ACT (an old AI-prophecy token) and CLAW (clawpump.tech, a gasless agent gateway). No shared story or source."
    },
    "k-model": {
      "decision": "rejected",
      "reason": "Generic word over LLM (credits lead), ACT and ANR (Avenro, a Robinhood Chain coin). No shared story."
    },
    "k-earn": {
      "decision": "deferred",
      "reason": "Overlaps the credits lead (k-credits): ORBIO and the earn-by-holding framing. OTC (\"earn stocks, pre-ipo, and yield\") stays with the deferred stock-reward coins (STONK, OTC, GSTOCK; project-only sources). Binance Man and flowroute match only on the word."
    },
    "k-platform": {
      "decision": "rejected",
      "reason": "Generic word over ACT, CLAW and SKYC. No shared story."
    },
